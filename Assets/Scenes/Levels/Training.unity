  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a4da6f1b09da5904ba704c486e45b811, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  messages:
  - Press screen to jump
  - you have control of the ball.
  - Your goal is to complete the level avoiding obstacles
  - Every time you die, your score decreases
  - If your score goes below zero, the episode starts from the last checkpoint
  - Pineapple and bananas increase your score
  - Increases apple speed
  - Cherry increases jumping power.
  - Watermelon increases both speed and jumping power.
  - Elements in red have the opposite effect.
  - Have fun!
  uiText: {fileID: 141632049}
